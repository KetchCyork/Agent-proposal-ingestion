# ---------------------------------------------------------------------------
# Agent-proposal-ingestion
#
# This repo reads documents from a local folder and POSTs them to the memory
# brain. It does NOT run the brain itself, so it needs no vault path, no
# Ollama URL and no LanceDB path -- those belong to the brain's own .env.
# ---------------------------------------------------------------------------

# The brain's HTTP endpoint.
#   Everything on one machine:  http://127.0.0.1:8377
#   Brain on another machine:   http://<its-tailnet-ip>:8377
MEMORY_URL=http://127.0.0.1:8377

# Must match MEMORY_API_KEY in the BRAIN's .env exactly. A mismatch fails every
# document with 401, which reads like a working run until the summary line.
MEMORY_API_KEY=

# ---------------------------------------------------------------------------
# Only for `npm run learn-style-remote`, which derives the proposal style
# profile. Plain ingestion never reads these.
# ---------------------------------------------------------------------------

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used to derive the profile. See https://openrouter.ai/models for
# current ids -- the built-in default lags behind what is available.
# STYLE_MODEL=anthropic/claude-sonnet-4-6

# How much material the profile is derived from.
# STYLE_SAMPLE_K=12
# STYLE_POLICY=proposal-drafting
# STYLE_SAMPLE_CHARS=120000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Where --changed-only records what it has already ingested.
# Defaults to <home>/.cowork-memory/ingest-manifest.json
# INGEST_MANIFEST=
